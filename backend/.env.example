SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_DATABASE_URL=postgresql+psycopg://postgres:password@db.your-project.supabase.co:5432/postgres
SUPABASE_SERVER_SECRET=your-server-secret
APP_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
GROQ_API_KEY=
NVIDIA_NIM_API_KEY=
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_REASONING_MODEL=openai/gpt-oss-120b
NVIDIA_AGENT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_ULTRA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
MODEL_MAX_COMPLETION_TOKENS=2048
MODEL_TIMEOUT_SECONDS=30
FEATURE_EXTERNAL_MARKET_INTELLIGENCE=true
FEATURE_CONTEXTUAL_BANDIT=true
FEATURE_ZK_BUDGET_SUFFICIENCY=true
FEATURE_MULTI_VERIFIER=true
FEATURE_B2B_PROCUREMENT=true
FEATURE_NEGOTIATION_SIMULATOR=true
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_PRIVACY_STACK=true
ADVANCED_VERIFICATION_THRESHOLD_MINOR=5000000
RAZORPAY_TEST_KEY_ID=rzp_test_placeholder
RAZORPAY_TEST_KEY_SECRET=replace-with-test-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-dashboard-webhook-secret
BLS_MANDATE_SIGNING_KEY=replace-with-independent-mandate-verifier-key
BLS_POLICY_SIGNING_KEY=replace-with-independent-policy-verifier-key
BLS_RISK_SIGNING_KEY=replace-with-independent-risk-verifier-key
CAMPAIGN_SCAN_INTERVAL_MINUTES=15
CAMPAIGN_INVENTORY_PRESSURE_THRESHOLD=15
CAMPAIGN_WEIGHT_INVENTORY_PRESSURE=0.30
CAMPAIGN_WEIGHT_CONVERSION_GAP=0.25
CAMPAIGN_WEIGHT_DEMAND_SIGNAL=0.20
CAMPAIGN_WEIGHT_MARGIN_ROOM=0.15
CAMPAIGN_WEIGHT_HISTORICAL_LIFT=0.10
